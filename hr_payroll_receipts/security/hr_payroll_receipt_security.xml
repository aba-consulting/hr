<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payroll_receipt_batch_rule_company" model="ir.rule">
        <field name="name">Payroll Receipt Batch: multi-company</field>
        <field name="model_id" ref="model_hr_payroll_receipt_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Portal: only read receipt lines linked to the portal user's employee -->
    <record id="hr_payroll_receipt_line_portal_rule" model="ir.rule">
        <field name="name">Receipt Line: portal own employee</field>
        <field name="model_id" ref="model_hr_payroll_receipt_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal: allow reading payslips (read-only) so Documents can resolve
         res_model references. Actual document visibility is controlled by
         documents.access (access_ids) not by payslip record rules. -->
    <record id="hr_payslip_portal_rule" model="ir.rule">
        <field name="name">Payslip: portal read-only</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
