<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend sign.request search view to add groupby by signers -->
    <record id="sign_request_view_search_inherit" model="ir.ui.view">
        <field name="name">sign.request.search.inherit</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="inside">
                <filter name="group_by_signer" string="Signer" domain="[]" context="{'group_by': 'signer_partner_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Server action: merge signed PDFs -->
    <record id="action_merge_signed_pdfs" model="ir.actions.server">
        <field name="name">Imprimir firmados (PDF combinado)</field>
        <field name="model_id" ref="sign.model_sign_request"/>
        <field name="binding_model_id" ref="sign.model_sign_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_merge_signed_pdfs()</field>
    </record>
</odoo>
