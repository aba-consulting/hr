<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payroll_employer_signature_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.employer.signature.wizard.form</field>
        <field name="model">hr.payroll.employer.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Firma del Empleador">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group string="Firma actual" invisible="not current_signature">
                        <field name="current_signature" widget="image"
                            options="{'size': [300, 100]}" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Nueva firma">
                        <field name="signature" widget="image" nolabel="1"
                            options="{'size': [400, 150], 'edit_on_write': True}"
                            help="Subí una imagen PNG o JPG de la firma del empleador."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object"
                        string="Guardar firma" class="btn-primary"/>
                    <button name="action_clear" type="object"
                        string="Eliminar firma actual"
                        invisible="not current_signature"
                        confirm="¿Estás seguro de eliminar la firma guardada?"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_employer_signature_wizard" model="ir.actions.act_window">
        <field name="name">Firma del Empleador</field>
        <field name="res_model">hr.payroll.employer.signature.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="hr_payroll_employer_signature_wizard_view_form"/>
    </record>

</odoo>
